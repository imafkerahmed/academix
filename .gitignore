# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production build
/build
dist/

# misc / OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
*.pem
*.key

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit these)
.env
.env.local
.env.production
.env.development
.env*.local

# Keep .env.example if you want to show which variables are needed
!.env.example

# Vercel / IDEs
.vercel
.vscode/
.idea/
.aiexclude

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Infrastructure & Services (Keep these on the server only) ---
services/
docker-compose.yml
docker-compose.override.yml

# --- PocketBase Specifics ---
# Ignore all database files and backups
pocketbase/pb_data/
*.db
*.db-shm
*.db-wal

# Only allow migrations and hooks if you are using them for version control
# Otherwise, it is safer to ignore these too if you manage them manually on the server
# !pocketbase/pb_migrations/
# !pocketbase/pb_hooks/

# --- Galene Specifics ---
# Already covered by ignoring the /services folder, but adding as a backup:
galene/data/
galene/groups/
galene/recordings/